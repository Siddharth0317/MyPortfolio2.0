# Database (Supabase PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-REF].supabase.co:5432/postgres"

# NextAuth.js Authentication
NEXTAUTH_SECRET="your-super-secret-nextauth-key-change-this"
NEXTAUTH_URL="http://localhost:3000"

# Admin Credentials (Initial Seeding / Fallback Auth)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="supersecretpassword"

# Resend Email API (For Viewer Contact Form)
RESEND_API_KEY="re_123456789_your_resend_api_key"
CONTACT_RECEIVER_EMAIL="your-email@example.com"
